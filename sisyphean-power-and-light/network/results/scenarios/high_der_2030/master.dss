! SP&L Scenario: High DER 2030
! Sisyphean Power & Light Distribution System Model

Clear

! Synthetic source; voltage and capacity follow the substation registry.
New Circuit.SPL bus1=sourcebus basekV=230.0 pu=1.04 phases=3 MVAsc3=2000 MVAsc1=2100
New Transformer.sub_xfmr phases=3 windings=2 buses=[sourcebus bus_SUB-001] conns=[delta wye] kvs=[230.0 12.47] kvas=[20000.0 20000.0] XHL=7

Redirect "../../../lines.dss"
Redirect "../../../transformers.dss"
Redirect "../../../loads.dss"
Redirect "pvsystems.dss"
Redirect "storage.dss"
Redirect "../../../capacitors.dss"

Set voltagebases=[0.12, 0.20784609690826525, 0.208, 0.24, 0.36026656797432643, 0.4156921938165305, 0.48, 0.831384387633061, 12.47, 230.0]
Calcvoltagebases

Redirect "../../../coordinates.dss"

Set tolerance=0.0001
Set maxiterations=100

Redirect "ev_loads.dss"
Set loadmult=1.0
Solve
