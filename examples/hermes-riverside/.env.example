# Hermes at Riverside — environment configuration
# Copy to .env and edit. Default: fully local, air-gapped.

# -----------------------------------------------------------------------------
# Provider selection: ollama | vllm | llama_cpp | bedrock
# Default is local Ollama. Bedrock is gated (see below).
# -----------------------------------------------------------------------------
HERMES_LLM_PROVIDER=ollama

# -----------------------------------------------------------------------------
# Model selection. Default is Gemma 4 E4B (MoE, "effective 4B" compute).
# Only Gemma 4 family models are supported as the local default.
# For higher quality on capable hardware, use a larger Gemma 4 variant
# (see `ollama pull gemma4:<tag>`).
# -----------------------------------------------------------------------------
HERMES_LLM_MODEL=gemma4:e4b

# -----------------------------------------------------------------------------
# Ollama endpoint (default: localhost). Set to cluster node if remote.
# -----------------------------------------------------------------------------
OLLAMA_API_BASE=http://localhost:11434

# -----------------------------------------------------------------------------
# Dynamic Network Model repo path. The SP&L adapter reads from this.
# If not set, defaults to ~/Projects/Dynamic-Network-Model.
# -----------------------------------------------------------------------------
# DNM_REPO_PATH=/Users/you/Projects/Dynamic-Network-Model

# -----------------------------------------------------------------------------
# vLLM / llama.cpp endpoints (OpenAI-compatible). Only used if provider set.
# -----------------------------------------------------------------------------
# VLLM_API_BASE=http://localhost:8000/v1
# LLAMA_CPP_API_BASE=http://localhost:8080/v1

# -----------------------------------------------------------------------------
# Bedrock (Claude) — VPC-ONLY. See docs/SECURITY.md before enabling.
# BOTH variables required. Startup aborts if either is missing or invalid.
# -----------------------------------------------------------------------------
# HERMES_BEDROCK_VPC_CONFIRMED=1
# AWS_ENDPOINT_URL_BEDROCK=https://bedrock-runtime.<region>.<vpce-id>.vpce.amazonaws.com
# AWS_REGION=us-east-1
# HERMES_LLM_MODEL=bedrock/anthropic.claude-sonnet-4-v1:0
